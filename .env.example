# ============================================================
# RAMANUJONOMICS - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git
# ============================================================

# ============================================================
# SUPABASE (Required)
# Get from: https://supabase.com/dashboard/project/[your-project]/settings/api
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# SITE (Required)
# ============================================================
NEXT_PUBLIC_SITE_URL=https://ramanujonomics.com
NEXT_PUBLIC_SITE_NAME=Ramanujonomics

# ============================================================
# ANALYTICS (Optional)
# PostHog: https://posthog.com
# ============================================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================
# EMAIL - Resend (Optional - Phase 2)
# https://resend.com/api-keys
# ============================================================
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=noreply@ramanujonomics.com

# ============================================================
# PAYMENT - Razorpay (Optional - Phase 4)
# https://dashboard.razorpay.com/app/keys
# ============================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ============================================================
# ADMIN (Used only for seeding)
# ============================================================
ADMIN_EMAIL=admin@ramanujonomics.com
