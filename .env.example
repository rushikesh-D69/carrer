# ============================================================
# RAMANUJONOMICS - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git
# ============================================================

# ============================================================
# SUPABASE (Required)
# Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/[your-project]/settings/api
#
# NEXT_PUBLIC_* vars are exposed to the browser (anon key is safe by design).
# SUPABASE_SERVICE_ROLE_KEY is SECRET — Vercel "Production" only, never commit.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# SITE (Required)
# ============================================================
NEXT_PUBLIC_SITE_URL=https://ramanujonomics.com
NEXT_PUBLIC_SITE_NAME=Ramanujonomics

# ============================================================
# ANALYTICS (Optional)
# PostHog: https://posthog.com
# ============================================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================
# EMAIL - Resend (Optional - Phase 2)
# https://resend.com/api-keys
# ============================================================
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=noreply@ramanujonomics.com

# ============================================================
# PAYMENT - Razorpay (Optional - Phase 4)
# https://dashboard.razorpay.com/app/keys
# ============================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ============================================================
# RATE LIMITING - Upstash Redis (Recommended for production)
# https://console.upstash.com → Create Redis → REST API
# Add same vars in Vercel Production environment
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================================
# BOT PROTECTION - Cloudflare Turnstile (Free)
# https://dash.cloudflare.com → Turnstile → Add site
# Site key = public, Secret key = server only
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ============================================================
# ADMIN (Used only for seeding)
# ============================================================

